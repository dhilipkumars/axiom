@@ -0,0 +1,20 @@
+# Added on top of docker-compose.local-dev.yml when the context is a kind
+# cluster.
+#
+# kind publishes its API server on host loopback, which a container cannot
+# reach -- but every kind node is also a container on kind's own Docker
+# network. Joining it lets the gateway address the node directly, which is the
+# same route e2e/lib/kind.sh takes and behaves identically on macOS and Linux.
+#
+# Only the gateway joins. Postgres stays on the compose bridge and still
+# reaches the gateway at gateway:8443, so nothing binds a host port that a
+# developer's own Postgres might already hold.
+services:
+  gateway:
+    networks:
+      - default
+      - kind
+
+networks:
+  kind:
+    external: true
diff --git a/deploy/compose/docker-compose.local-dev.yml b/deploy/compose/docker-compose.local-dev.yml
new file mode 100644
index 0000000..231cb80
--- /dev/null
+++ b/deploy/compose/docker-compose.local-dev.yml
@@ -0,0 +1,54 @@
+# Overlay for `make local-dev-up`. Driven by scripts/local-dev, which decides
+# how this cluster should be reached and prepares the kubeconfig.
+#
+# The base stack already mints a throwaway CA and server certificate in its
+# `certs` init service and both services wait on it, so there is no openssl
+# ceremony here and no plaintext path: the dev stack speaks the same TLS the
+# deployed one does.
+services:
+  # A bind-mounted kubeconfig is unreadable by the gateway, which runs as
+  # nonroot (uid 65532). On Linux a bind mount keeps the host inode's
+  # ownership, so a file the developer owns is denied to 65532 -- and loosening
+  # it to 0644 would leave cluster credentials world-readable on disk.
+  # Copying it into a volume as root and chowning is what certs/gen.sh already
+  # does for the server key.
+  kubeconfig:
+    image: alpine:3.20
+    user: root
+    entrypoint:
+      - /bin/sh
+      - -c
+      - install -o 65532 -g 65532 -m 0600 /in/config /kube/config
+    volumes:
+      - ${AXIOM_KUBECONFIG:-/dev/null}:/in/config:ro
+      - kube:/kube
+
+  gateway:
+    command:
+      - -listen
+      - :8443
+      - -tls-cert
+      - /certs/gateway.crt
+      - -tls-key
+      - /certs/gateway.key
+      - -kubeconfig
+      - /kube/config
+      # No -serve: it narrows nothing by default, so the credentials in the
+      # kubeconfig are the bound -- the same rule the deployed gateway follows.
+    volumes:
+      - certs:/certs:ro
+      - kube:/kube:ro
+    depends_on:
+      certs:
+        condition: service_completed_successfully
+      kubeconfig:
+        condition: service_completed_successfully
+
+  postgres:
+    # Loopback only. This password is a development constant, so the port must
+    # not be routable.
+    ports:
+      - "127.0.0.1:${AXIOM_PG_PORT:-55432}:5432"
+
+volumes:
+  kube:
