#!/usr/bin/env bash
# Extension line coverage from unit tests and the e2e suite, separately and
# merged (#90).
#
#   scripts/coverage-report-extension UNIT_LCOV E2E_LCOV
#
# Both are what scripts/extension-coverage-lcov wrote; either may be missing,
# and its column then reads "-". Merged by file and line: the unit and e2e
# builds are different binaries (debug test build, release .so), so their raw
# profiles are not merged, but the lines they execute are. Prints a Markdown
# table on stdout, one row per source file.
set -euo pipefail

[[ $# -eq 2 ]] || { echo "usage: $(basename "$0") UNIT_LCOV E2E_LCOV" >&2; exit 2; }
unit="$1" e2e="$2"
[[ -s "$unit" ]] || unit=/dev/null
[[ -s "$e2e" ]] || e2e=/dev/null

echo "### Extension coverage"
echo
if [[ "$unit" == /dev/null && "$e2e" == /dev/null ]]; then
  echo "No extension coverage data was recorded, so there is nothing to report."
  exit 0
fi
echo "| file | unit | e2e | combined |"
echo "|---|---:|---:|---:|"
awk -v ufile="$unit" -v has_u="$([[ "$unit" != /dev/null ]] && echo 1 || echo 0)" \
    -v has_e="$([[ "$e2e" != /dev/null ]] && echo 1 || echo 0)" '
  FNR == 1 { src = (FILENAME == ufile ? "u" : "e") }
  /^SF:/ { f = substr($0, 4); next }
  /^DA:/ { split(substr($0, 4), a, ","); key = f SUBSEP a[1]
           line[key] = 1; files[f] = 1
           if (a[2] > 0) hit[src, key] = 1
           next }
  END {
    for (k in line) {
      split(k, p, SUBSEP); t[p[1]]++; T++
      if (hit["u", k]) { u[p[1]]++; U++ }
      if (hit["e", k]) { e[p[1]]++; E++ }
      if (hit["u", k] || hit["e", k]) { c[p[1]]++; C++ }
    }
    for (f in files)
      printf "| `%s` | %s | %s | **%.1f%%** |\n", f,
        has_u ? sprintf("%.1f%%", 100 * u[f] / t[f]) : "-",
        has_e ? sprintf("%.1f%%", 100 * e[f] / t[f]) : "-",
        100 * c[f] / t[f] | "sort"
    close("sort")
    printf "| **total** | %s | %s | **%.1f%%** |\n",
      has_u ? sprintf("%.1f%%", 100 * U / T) : "-",
      has_e ? sprintf("%.1f%%", 100 * E / T) : "-", 100 * C / T
  }' "$unit" "$e2e"
echo
echo "Line coverage of extension/src; generated protobuf code excluded. It measures what ran, not what was asserted."
