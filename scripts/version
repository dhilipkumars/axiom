#!/usr/bin/env bash
# Prints the project version, or checks that everything agrees with it.
#
#   scripts/version           # print, e.g. 0.1.0
#   scripts/version check     # verify the places that carry it agree
#   scripts/version check v0.1.0   # ...and that a release tag matches
#
# extension/Cargo.toml is the source of truth. It is the only place a version
# is declared rather than injected: `axiom.control` templates it through pgrx
# as `@CARGO_VERSION@`, `axiom_version()` reads it as `CARGO_PKG_VERSION`, and
# the gateway takes it as a build argument that defaults to "dev". So the check
# is not "do three files match" but "does everything derive from the one that
# declares it, and does the tag being released agree".
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="$ROOT/extension/Cargo.toml"

die() { printf 'version: %s\n' "$*" >&2; exit 1; }

# The [package] version, not a dependency's. Stops at the next table header.
version="$(awk '
  /^\[/ { in_pkg = ($0 == "[package]"); next }
  in_pkg && /^version[[:space:]]*=/ {
    sub(/^version[[:space:]]*=[[:space:]]*"/, ""); sub(/".*$/, ""); print; exit
  }
' "$MANIFEST")"
[[ -n "$version" ]] || die "no [package] version in extension/Cargo.toml"

# The spelling packages use. Semver writes a prerelease with a hyphen; neither
# package manager will take that. rpm rejects a hyphen in Version outright
# because it separates version from release, and dpkg would read what follows
# as the Debian revision, so the final 0.1.2-1 would compare as *older* than
# 0.1.2-rc.1 and apt would refuse the upgrade. Both spell it with a tilde,
# which sorts before the release it precedes:
#
#   0.1.1  <  0.1.2~rc.1  <  0.1.2
#
# Computed here rather than in each caller, so scripts/package-native and the
# gate that looks for the filenames it writes cannot disagree about it.
if [[ "${1:-}" == "package" ]]; then
  # An explicit version wins over the manifest. package-native is run directly
  # against an unpacked tarball to build packages for a release the working
  # tree is no longer on -- which is how v0.1.1's packages were made -- and
  # reading Cargo.toml there would name the files after the wrong release.
  pkg_version="${2:-$version}"

  # Only the first hyphen separates a prerelease, and only one can be
  # represented. `1.0.0-alpha-2` would become `1.0.0~alpha~2`, which sorts
  # *before* `1.0.0~alpha` in both dpkg and rpm -- the reverse of what semver
  # means -- and rpm cannot hold the hyphen that would spell it correctly. So
  # refuse rather than ship a package that orders wrongly.
  rest="${pkg_version#*-}"
  if [[ "$pkg_version" == *-* && "$rest" == *-* ]]; then
    die "cannot package version '$pkg_version': more than one hyphen has no correct
  spelling in dpkg or rpm. Use a single prerelease segment, such as
  ${pkg_version%%-*}-rc.1"
  fi
  # Built by concatenation, not `${pkg_version/-/~}`. The replacement string in
  # a substitution undergoes tilde expansion, and bash 5 does it even here:
  # that form yields 0.1.2~rc.1 on macOS's bash 3.2 and 0.1.2/home/runnerrc.1
  # on a GitHub runner, which dpkg then rejects. A tilde inside double quotes
  # in the middle of a word is never expanded, so this spells the same thing on
  # both.
  if [[ "$pkg_version" == *-* ]]; then
    printf '%s\n' "${pkg_version%%-*}~${pkg_version#*-}"
  else
    printf '%s\n' "$pkg_version"
  fi
  exit 0
fi

case "${1:-}" in
  "")      printf '%s\n' "$version"; exit 0 ;;
  check)   ;;
  # Anything else is a typo. Printing the version and exiting 0 for
  # `scripts/version pkg` would look like success and hand the caller a
  # plausible wrong answer, which is the failure this script exists to prevent.
  *)       die "unknown mode '$1'; expected no argument, 'package [<version>]', or 'check [<tag>]'" ;;
esac

# The control file must template the version rather than pin it. A literal here
# would be a second source of truth, and it would be wrong the first time the
# version changed and nobody remembered this file.
grep -q "^default_version = '@CARGO_VERSION@'" "$ROOT/extension/axiom.control" \
  || die "extension/axiom.control should template default_version as '@CARGO_VERSION@'"

# The gateway's default is deliberately "dev" so an unstamped binary says so
# rather than claiming a release it is not.
grep -q '^var version = "dev"' "$ROOT/gateway/cmd/gateway/main.go" \
  || die 'gateway/cmd/gateway/main.go should default version to "dev"'

tag="${2:-}"
if [[ -n "$tag" ]]; then
  [[ "$tag" == "v$version" ]] \
    || die "tag $tag does not match extension/Cargo.toml version $version (expected v$version)"
fi

printf 'version %s, consistent%s\n' "$version" "${tag:+ with tag $tag}"
