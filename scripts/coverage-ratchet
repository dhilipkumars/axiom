#!/usr/bin/env bash
# Fails when coverage drops (#90).
#
#   scripts/coverage-ratchet BASELINE TOTALS...
#
# BASELINE holds "component<TAB>layer<TAB>percent" lines, committed in the
# repository; each TOTALS file is what scripts/coverage-report or
# scripts/coverage-report-extension wrote for the run. For every figure the
# baseline has, the run must not be more than TOLERANCE points below it, and
# must have measured it at all.
#
# A ratchet rather than fixed floors: it stops coverage eroding without
# pretending a number is a target. A figure that rose past the tolerance is
# reported, so the baseline can be raised in the same PR -- lowering it is a
# decision a reviewer sees in the diff. A figure the baseline does not have
# yet is reported and passes.
set -euo pipefail

TOLERANCE="${COVERAGE_TOLERANCE:-0.5}"
[[ $# -ge 2 ]] || { echo "usage: $(basename "$0") BASELINE TOTALS..." >&2; exit 2; }
baseline="$1"; shift
# A report that recorded nothing writes no totals file. Read it as empty, so
# its figures show as not measured -- which fails -- instead of awk stopping
# before the table is complete.
inputs=()
for f in "$@"; do [[ -f "$f" ]] && inputs+=("$f") || inputs+=(/dev/null); done

echo "### Coverage ratchet"
echo
echo "| component | layer | baseline | this run | |"
echo "|---|---|---:|---:|---|"
awk -F'\t' -v tol="$TOLERANCE" -v base="$baseline" '
  /^#/ || NF < 3 { next }
  FILENAME == base { b[$1 "\t" $2] = $3; next }
  { r[$1 "\t" $2] = $3 }
  END {
    fail = 0
    for (k in b) keys[k] = 1
    for (k in r) keys[k] = 1
    n = 0; for (k in keys) order[++n] = k
    for (i = 2; i <= n; i++) { v = order[i]; for (j = i - 1; j >= 1 && order[j] > v; j--) order[j + 1] = order[j]; order[j + 1] = v }
    for (i = 1; i <= n; i++) {
      k = order[i]; split(k, p, "\t")
      # A figure the baseline holds but this run did not produce means the
      # collection broke, not that coverage is fine: passing it would switch
      # the ratchet off without anyone noticing.
      if (!(k in r)) { verdict = "**not measured this run**"; shown = "-"; fail = 1 }
      else if (!(k in b)) { verdict = "no baseline yet"; shown = r[k] "%" }
      else {
        # Rounded to the tenth the figures carry: in binary 63.9 - 64.4 is
        # -0.50000000000000711, which would fail a drop of exactly the
        # tolerance that 85.1 - 85.6 passes.
        shown = r[k] "%"; d = sprintf("%.1f", r[k] - b[k]) + 0
        if (d < -tol) { verdict = sprintf("**dropped %.1f**", -d); fail = 1 }
        else if (d > tol) verdict = sprintf("up %.1f: raise the baseline", d)
        else verdict = "ok"
      }
      printf "| %s | %s | %s | %s | %s |\n", p[1], p[2], (k in b) ? b[k] "%" : "-", shown, verdict
    }
    exit fail
  }' "$baseline" "${inputs[@]}" || {
  echo
  echo "Coverage dropped by more than ${TOLERANCE} points, or a figure was not measured. For a drop, add tests for the code this change leaves unexercised, or, if it is deliberate, lower the figure in $(basename "$baseline") so a reviewer sees it. For a missing figure, the coverage collection itself failed: see the report steps above."
  exit 1
}
echo
echo "Within ${TOLERANCE} points of $(basename "$baseline") on every figure. The baseline only moves when someone edits it."
